{
  "name": "whosnext",
  "version": "0.1.0",
  "description": "A multiplayer card party game with Quick Play and Who's Next modes",
  "author": "ccd-69",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names VITE,SERVER,ELECTRON \"npm:dev:vite\" \"npm:dev:server\" \"npm:dev:electron\"",
    "dev:vite": "vite --config vite.renderer.config.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron . --remote-debugging-port=9222",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && vite build --config vite.renderer.config.ts",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.ccd69.whosnext",
    "productName": "Who's Next?",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "asar": true,
    "win": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "icons/icon.png",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.17.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
